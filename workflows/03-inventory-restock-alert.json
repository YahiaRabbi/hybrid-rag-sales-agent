{
  "name": "03 - Inventory Restock Alert",
  "nodes": [
    {
      "id": "v1",
      "name": "Every Day 9 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 9
            }
          ]
        }
      }
    },
    {
      "id": "v2",
      "name": "Run Now (Webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        200
      ],
      "webhookId": "inventory-run",
      "parameters": {
        "httpMethod": "POST",
        "path": "inventory-run",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "v3",
      "name": "Get Low Stock Products",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        100
      ],
      "alwaysOutputData": true,
      "parameters": {
        "operation": "executeQuery",
        "query": "select product_name, category, availability from public.products where availability in ('Low Stock','Out of Stock') order by availability desc, category, product_name;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Postgres (read-only bot role)"
        }
      }
    },
    {
      "id": "v4",
      "name": "Build Restock List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        100
      ],
      "parameters": {
        "jsCode": "// Deterministic part: the numbers never come from the AI.\nconst rows = $input.all().map(i => i.json).filter(r => r.product_name);\nconst out = rows.filter(r => r.availability === 'Out of Stock');\nconst low = rows.filter(r => r.availability === 'Low Stock');\nconst OUT_QTY = 20; // units to reorder for out-of-stock items\nconst LOW_QTY = 10; // units to reorder for low-stock items\nconst fmt = (r, q) => `- ${r.product_name} (${r.category}) \\u2014 ${q} units`;\nconst list = [\n  `OUT OF STOCK (${out.length} items, ${OUT_QTY} units each):`,\n  ...out.map(r => fmt(r, OUT_QTY)),\n  '',\n  `LOW STOCK (${low.length} items, ${LOW_QTY} units each):`,\n  ...low.map(r => fmt(r, LOW_QTY)),\n].join('\\n');\nreturn [{ json: {\n  total: rows.length,\n  out_count: out.length,\n  low_count: low.length,\n  total_units: out.length * OUT_QTY + low.length * LOW_QTY,\n  date: $now.setZone('Asia/Dhaka').toFormat('dd LLL yyyy'),\n  list,\n} }];"
      }
    },
    {
      "id": "v5",
      "name": "Anything to Restock?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.total }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "v6",
      "name": "AI Writes Restock Email",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        960,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 10000,
      "parameters": {
        "promptType": "define",
        "text": "=You write purchase-order emails for Noorzaah, a Bangladesh fashion brand selling Pakistani-style dresses.\n\nWrite a short, professional B2B restock email to our supplier.\nRules:\n- Start with \"Dear Supplier,\" (no religious greetings).\n- One short opening line, then copy the product list below EXACTLY as given. Do not change any product name, category or quantity, and do not add or remove items.\n- After the list, state the total: {{ $json.total_units }} units across {{ $json.total }} products.\n- Ask the supplier to confirm availability and expected delivery date.\n- End with \"Regards,\\nNoorzaah Inventory Team\".\n- Plain text only, no markdown, no subject line.\n\nDate: {{ $json.date }}\n\nProduct list:\n{{ $json.list }}"
      }
    },
    {
      "id": "v7",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        960,
        220
      ],
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {
          "temperature": 0.2
        }
      },
      "credentials": {
        "googlePalmApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Google Gemini API"
        }
      }
    },
    {
      "id": "v8",
      "name": "Gmail Draft to Supplier",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1260,
        0
      ],
      "webhookId": "gmail-draft",
      "parameters": {
        "resource": "draft",
        "subject": "=Noorzaah restock order – {{ $('Build Restock List').item.json.date }}",
        "message": "={{ $json.text }}",
        "options": {
          "sendTo": "supplier@example.com"
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Gmail OAuth2"
        }
      }
    }
  ],
  "connections": {
    "Every Day 9 AM": {
      "main": [
        [
          {
            "node": "Get Low Stock Products",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Now (Webhook)": {
      "main": [
        [
          {
            "node": "Get Low Stock Products",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Low Stock Products": {
      "main": [
        [
          {
            "node": "Build Restock List",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Restock List": {
      "main": [
        [
          {
            "node": "Anything to Restock?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Anything to Restock?": {
      "main": [
        [
          {
            "node": "AI Writes Restock Email",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "AI Writes Restock Email": {
      "main": [
        [
          {
            "node": "Gmail Draft to Supplier",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Gemini Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Writes Restock Email",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Dhaka"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  }
}