{
  "name": "06 - Telegram Customer Channel",
  "nodes": [
    {
      "id": "g1",
      "name": "Telegram Message",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "webhookId": "telegram-in",
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "id": "g2",
      "name": "Normalize",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "n1",
              "name": "chat_id",
              "value": "={{ $json.message.chat.id }}",
              "type": "string"
            },
            {
              "id": "n2",
              "name": "session_id",
              "value": "=tg_{{ $json.message.chat.id }}",
              "type": "string"
            },
            {
              "id": "n3",
              "name": "message",
              "value": "={{ $json.message.text || '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "g3",
      "name": "Is Text?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.message }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "g4",
      "name": "Show Typing",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        660,
        -100
      ],
      "webhookId": "tg-typing",
      "onError": "continueRegularOutput",
      "parameters": {
        "resource": "chat",
        "operation": "sendChatAction",
        "chatId": "={{ $json.chat_id }}",
        "action": "typing"
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "id": "g5",
      "name": "Ask AI Sales Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -100
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Webhook Secret (X-Webhook-Key)"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/sales-agent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ session_id: $('Normalize').item.json.session_id, message: $('Normalize').item.json.message }) }}",
        "options": {
          "timeout": 90000
        }
      }
    },
    {
      "id": "g6",
      "name": "Reply to Customer",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1100,
        -100
      ],
      "webhookId": "tg-reply",
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Normalize').item.json.chat_id }}",
        "text": "={{ $json.output ? $json.output : 'Sorry, I am having a little trouble right now. Please try again in a minute, or message us on WhatsApp and our team will help you.' }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "id": "g7",
      "name": "Text Only Notice",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        660,
        120
      ],
      "webhookId": "tg-nontext",
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.chat_id }}",
        "text": "Thanks! I can only read text messages for now. Please type your question, for example: \"Do you have velvet dresses under 15000?\"",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "Telegram Message": {
      "main": [
        [
          {
            "node": "Normalize",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize": {
      "main": [
        [
          {
            "node": "Is Text?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Text?": {
      "main": [
        [
          {
            "node": "Show Typing",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Text Only Notice",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Show Typing": {
      "main": [
        [
          {
            "node": "Ask AI Sales Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ask AI Sales Agent": {
      "main": [
        [
          {
            "node": "Reply to Customer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Dhaka"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  }
}